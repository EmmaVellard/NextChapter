{
  "name": "next-chapter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:pages": "GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/NextChapter next build --webpack",
    "fonts": "node scripts/fetch-fonts.mjs",
    "icons": "node scripts/generate-app-icons.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "catalog": "node --experimental-strip-types scripts/enrich-library-metadata.ts",
    "start": "next start",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "quality": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb": "8.0.3",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "papaparse": "5.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "^0.35.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "type": "module"
}
